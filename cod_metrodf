    "Terminal Asa Sul", "Shopping", "Feira", "Guara", "Arniqueiras",
    "Aguas Claras", "Concessionarias", "Estrada Parque",
    "Praca do Relogio", "Centro Metropolitano"
};

const char *linhaVerde[TOTAL_VERDE] = {
    "Central", "Galeria", "108 Sul", "112 Sul", "114 Sul", "Asa Sul",
    "Terminal Asa Sul", "Shopping", "Feira", "Guara", "Arniqueiras",
    "Aguas Claras", "Concessionarias", "Estrada Parque",
    "Praca do Relogio", "Centro Metropolitano", "Taguatinga Sul",
    "Furnas", "Samambaia Sul", "Samambaia"
};

const char *linhaLaranja[TOTAL_LARANJA] = {
    "Central", "Galeria", "108 Sul", "112 Sul", "114 Sul", "Asa Sul",
    "Terminal Asa Sul", "Shopping", "Feira", "Guara", "Arniqueiras",
